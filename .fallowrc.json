{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/entry.ts",
    "src/main.ts",
    "src/**/*.test.ts",
    "src/**/*.browser.ts",
    "scripts/**/*.{mjs,ts}",
    "vite.config.ts"
  ],
  "ignorePatterns": ["src/web/componentStyles.generated.ts", "src/components/ui/label.ts"],
  "ignoreExports": [
    {
      "file": "src/components/ui/**",
      "exports": ["*"]
    },
    {
      "file": "src/store/{modules,queries}.ts",
      "exports": ["*"]
    },
    {
      "file": "src/components/app/icons.ts",
      "exports": ["icon"]
    }
  ],
  "ignoreDependencies": ["@effect/ui-devtools", "@effect/language-service"]
}
