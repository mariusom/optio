{
  "name": "optio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/license-assurance.mjs && vp dev",
    "build": "node scripts/license-assurance.mjs && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "lint:dead": "fallow dead-code",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser",
    "test:e2e": "node --test scripts/storage.e2e.mjs && node scripts/test-public-metadata.mjs",
    "licenses:generate": "node scripts/license-assurance.mjs",
    "licenses:check": "vp test run scripts/license-assurance.test.mjs && node scripts/license-assurance.mjs --check",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.6",
    "@foldkit/ui": "0.169.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@livestore/adapter-web": "0.5.0",
    "@livestore/livestore": "0.5.0",
    "@livestore/wa-sqlite": "0.5.0",
    "@opentelemetry/api": "1.9.1",
    "cn": "^0.5.0",
    "effect": "4.0.6",
    "foldkit": "0.169.0",
    "lucide": "^1.61.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.57.0",
    "@effect/vitest": "4.0.6",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "catalog:",
    "fallow": "^3.36.0",
    "playwright": "^1.64.1",
    "rolldown": "1.2.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.15.0"
}
