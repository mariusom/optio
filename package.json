{
  "name": "optio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/license-assurance.mjs && vp dev",
    "build": "node scripts/license-assurance.mjs && vp build",
    "preview": "vp preview",
    "check": "effect-tsgo vp check",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint:dead": "fallow dead-code",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser",
    "test:e2e": "node --test scripts/storage.e2e.mjs && node scripts/test-public-metadata.mjs && pnpm test:a11y",
    "test:a11y": "node --test scripts/accessibility.e2e.mjs scripts/lighthouse.e2e.mjs",
    "licenses:generate": "node scripts/license-assurance.mjs",
    "licenses:check": "vp test run scripts/license-assurance.test.mjs && node scripts/license-assurance.mjs --check"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.5",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@7bff56b",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@7bff56b",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@tanstack/table-core": "9.3.1",
    "cn": "^0.5.2",
    "effect": "4.1.5",
    "lucide": "^1.77.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@effect/ui-devtools": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-devtools@7bff56b",
    "@effect/vitest": "4.1.5",
    "@opentelemetry/api": "1.9.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "4.14.0",
    "fallow": "^3.45.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.4",
    "tsrs": "7.1.0-beta.tsrs2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.21.0"
}
