    "@livestore/livestore": "0.5.0-dev.0",
    "@livestore/wa-sqlite": "0.5.0-dev.0",
    "@typeonce/effect-machine": "0.37.0",
    "cn": "^0.3.0",
    "effect": "4.0.0-rc.112",
    "foldkit": "^0.159.0",
    "lucide": "^1.47.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@foldkit/vite-plugin": "^0.21.0",
